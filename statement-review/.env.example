# Copy to .env and fill in. Never commit .env.
# Leave DEV_DATABASE_URL empty to use a local SQLite file (statements_dev.db).
DEV_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@dev-host:5432/finance
PROD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@prod-host:5432/finance
# Set to 0 if the tables are managed by your own migrations (see schema.sql).
AUTO_CREATE_TABLES=1
